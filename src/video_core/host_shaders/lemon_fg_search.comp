// Lemon frame generation: block motion search at one pyramid level. One workgroup per 8x8 block,
// one invocation per pixel of it: each candidate vector's cost is summed across the workgroup
// with subgroup adds (the whole block is usually one subgroup, so no barrier at all).
//
// Finds, for every block, the vector v (in this level's pixels) that best matches luma A at
// x + ka * v against luma C at x + kc * v. Forward flow (A -> C, blocks anchored on A) is
// ka = 0, kc = 1; backward (C -> A, anchored on C) is ka = 1, kc = 0.
//
// mode 0: coarsest level, exhaustive search of +-SEARCH_RADIUS pixels (plus the temporal vector).
// mode 1: first pass of a finer level, starting from the coarser level's result scaled by 2.
// mode 2: further passes, starting from the previous pass's result.
// Passes 1 and 2 try the neighbours' vectors (at distance 1 and 3), the neighbourhood median and
// the previous frame pair's vectors, then refine the winner by +-1 pixel (3DRS-style).
// The cost is the sum of absolute differences (0-255 scale) plus penalties for long vectors
// and for vectors far from the neighbourhood median, which keep flat areas still and the field
// smooth.
//
// No private arrays: indexed at run time they end up in slow memory on mobile GPUs.

#version 460 core
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler linear_sampler;
layout(set = 0, binding = 1) uniform texture2D luma_a;
layout(set = 0, binding = 2) uniform texture2D luma_c;
layout(set = 0, binding = 3) uniform texture2D field_in;
layout(set = 0, binding = 4) uniform texture2D temporal;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D field_out;

layout(push_constant) uniform PushConstants {
    ivec2 level_size;
    ivec2 grid;
    ivec2 in_grid;
    float ka;
    float kc;
    int mode;
    int use_temporal;
    float temporal_scale;
    float zero_bias;
    float smooth_bias;
};

const int BLOCK = 8;
const int PIXELS = BLOCK * BLOCK;
const int SEARCH_RADIUS = 6;

shared float subgroup_sums[PIXELS];

ivec2 block;
vec2 position;
vec2 inv_size;
vec2 median;
bool with_median;
vec2 best;
float best_cost;

vec2 InField(ivec2 at) {
    if (mode == 1) {
        const ivec2 coarse = clamp(at / 2, ivec2(0), in_grid - 1);
        return texelFetch(sampler2D(field_in, linear_sampler), coarse, 0).xy * 2.0;
    }
    return texelFetch(sampler2D(field_in, linear_sampler), clamp(at, ivec2(0), in_grid - 1), 0).xy;
}

vec2 TemporalField(ivec2 at) {
    const vec2 uv = (vec2(clamp(at, ivec2(0), grid - 1)) + 0.5) / vec2(grid);
    return textureLod(sampler2D(temporal, linear_sampler), uv, 0.0).xy * temporal_scale;
}

// |A - C| summed over the block, the same in every invocation.
float BlockSad(vec2 v) {
    const float a =
        textureLod(sampler2D(luma_a, linear_sampler), (position + ka * v) * inv_size, 0.0).r;
    const float c =
        textureLod(sampler2D(luma_c, linear_sampler), (position + kc * v) * inv_size, 0.0).r;
    float sum = subgroupAdd(abs(a - c));
    if (gl_NumSubgroups > 1) {
        // Smaller subgroups (Mali): add up the subgroups' sums.
        if (subgroupElect()) {
            subgroup_sums[gl_SubgroupID] = sum;
        }
        barrier();
        sum = 0.0;
        for (uint i = 0; i < gl_NumSubgroups; ++i) {
            sum += subgroup_sums[i];
        }
        barrier();
    }
    return sum * 255.0;
}

void Try(vec2 v) {
    float cost = BlockSad(v) + zero_bias * float(BLOCK) * (abs(v.x) + abs(v.y));
    if (with_median) {
        const vec2 d = abs(v - median);
        cost += smooth_bias * float(BLOCK) * (d.x + d.y);
    }
    if (cost < best_cost) {
        best_cost = cost;
        best = v;
    }
}

void Sort2(inout vec2 a, inout vec2 b) {
    const vec2 low = min(a, b);
    b = max(a, b);
    a = low;
}

// Per-component median of nine vectors: the 19-exchange median network.
vec2 Median9(vec2 p0, vec2 p1, vec2 p2, vec2 p3, vec2 p4, vec2 p5, vec2 p6, vec2 p7, vec2 p8) {
    Sort2(p1, p2); Sort2(p4, p5); Sort2(p7, p8);
    Sort2(p0, p1); Sort2(p3, p4); Sort2(p6, p7);
    Sort2(p1, p2); Sort2(p4, p5); Sort2(p7, p8);
    Sort2(p0, p3); Sort2(p5, p8); Sort2(p4, p7);
    Sort2(p3, p6); Sort2(p1, p4); Sort2(p2, p5);
    Sort2(p4, p7); Sort2(p4, p2); Sort2(p6, p4);
    Sort2(p4, p2);
    return p4;
}

void main() {
    block = ivec2(gl_WorkGroupID.xy);
    position = vec2(block * BLOCK + ivec2(gl_LocalInvocationID.xy)) + 0.5;
    inv_size = 1.0 / vec2(level_size);
    best = vec2(0.0);
    best_cost = 3.4e38;

    if (mode == 0) {
        with_median = false;
        for (int dy = -SEARCH_RADIUS; dy <= SEARCH_RADIUS; ++dy) {
            for (int dx = -SEARCH_RADIUS; dx <= SEARCH_RADIUS; ++dx) {
                Try(vec2(dx, dy));
            }
        }
        if (use_temporal != 0) {
            Try(TemporalField(block));
        }
    } else {
        const vec2 own = InField(block);
        median = Median9(InField(block + ivec2(-1, -1)), InField(block + ivec2(0, -1)),
                         InField(block + ivec2(1, -1)), InField(block + ivec2(-1, 0)), own,
                         InField(block + ivec2(1, 0)), InField(block + ivec2(-1, 1)),
                         InField(block + ivec2(0, 1)), InField(block + ivec2(1, 1)));
        with_median = true;

        Try(own);
        Try(median);
        for (int s = 1; s <= 3; s += 2) {
            Try(InField(block + ivec2(s, 0)));
            Try(InField(block + ivec2(-s, 0)));
            Try(InField(block + ivec2(0, s)));
            Try(InField(block + ivec2(0, -s)));
        }
        if (use_temporal != 0) {
            Try(TemporalField(block));
            for (int s = 1; s <= 3; s += 2) {
                Try(TemporalField(block + ivec2(s, 0)));
                Try(TemporalField(block + ivec2(-s, 0)));
                Try(TemporalField(block + ivec2(0, s)));
                Try(TemporalField(block + ivec2(0, -s)));
            }
        }

        const vec2 centre = best;
        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                if (dx != 0 || dy != 0) {
                    Try(centre + vec2(dx, dy));
                }
            }
        }
    }
    if (gl_LocalInvocationIndex == 0) {
        imageStore(field_out, block, vec4(best, 0.0, 0.0));
    }
}
