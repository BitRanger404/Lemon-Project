// Lemon frame generation: block motion search at one pyramid level. One invocation per 8x8 block.
//
// Finds, for every block, the vector v (in this level's pixels) that best matches luma A at
// x + ka * v against luma C at x + kc * v. Forward flow (A -> C, blocks anchored on A) is
// ka = 0, kc = 1; backward (C -> A, anchored on C) is ka = 1, kc = 0.
//
// mode 0: coarsest level, exhaustive search of +-SEARCH_RADIUS pixels (plus the temporal vector).
// mode 1: first pass of a finer level, starting from the coarser level's result scaled by 2.
// mode 2: further passes, starting from the previous pass's result.
// Passes 1 and 2 try the neighbours' vectors (at distance 1 and 3), the neighbourhood median and
// the previous frame pair's vectors, then refine the winner by +-1 pixel (3DRS-style).
// The cost is the sum of absolute differences (0-255 scale) plus penalties for long vectors
// and for vectors far from the neighbourhood median, which keep flat areas still and the field
// smooth.

#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler linear_sampler;
layout(set = 0, binding = 1) uniform texture2D luma_a;
layout(set = 0, binding = 2) uniform texture2D luma_c;
layout(set = 0, binding = 3) uniform texture2D field_in;
layout(set = 0, binding = 4) uniform texture2D temporal;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D field_out;

layout(push_constant) uniform PushConstants {
    ivec2 level_size;
    ivec2 grid;
    ivec2 in_grid;
    float ka;
    float kc;
    int mode;
    int use_temporal;
    float temporal_scale;
    float zero_bias;
    float smooth_bias;
};

const int BLOCK = 8;
const int SEARCH_RADIUS = 6;

vec2 InField(ivec2 block) {
    if (mode == 1) {
        const ivec2 coarse = clamp(block / 2, ivec2(0), in_grid - 1);
        return texelFetch(sampler2D(field_in, linear_sampler), coarse, 0).xy * 2.0;
    }
    return texelFetch(sampler2D(field_in, linear_sampler), clamp(block, ivec2(0), in_grid - 1), 0)
        .xy;
}

vec2 TemporalField(ivec2 block) {
    const vec2 uv = (vec2(clamp(block, ivec2(0), grid - 1)) + 0.5) / vec2(grid);
    return textureLod(sampler2D(temporal, linear_sampler), uv, 0.0).xy * temporal_scale;
}

float Sad(ivec2 block, vec2 v) {
    const vec2 inv_size = 1.0 / vec2(level_size);
    const vec2 base = vec2(block * BLOCK) + 0.5;
    float sad = 0.0;
    for (int y = 0; y < BLOCK; ++y) {
        for (int x = 0; x < BLOCK; ++x) {
            const vec2 p = base + vec2(x, y);
            const float a = textureLod(sampler2D(luma_a, linear_sampler), (p + ka * v) * inv_size,
                                       0.0).r;
            const float c = textureLod(sampler2D(luma_c, linear_sampler), (p + kc * v) * inv_size,
                                       0.0).r;
            sad += abs(a - c);
        }
    }
    return sad * 255.0;
}

float Cost(ivec2 block, vec2 v, vec2 median, bool with_median) {
    float cost = Sad(block, v) + zero_bias * float(BLOCK) * (abs(v.x) + abs(v.y));
    if (with_median) {
        const vec2 d = abs(v - median);
        cost += smooth_bias * float(BLOCK) * (d.x + d.y);
    }
    return cost;
}

float Median9(float v[9]) {
    // Partial selection sort up to the middle element.
    for (int i = 0; i <= 4; ++i) {
        int smallest = i;
        for (int j = i + 1; j < 9; ++j) {
            if (v[j] < v[smallest]) {
                smallest = j;
            }
        }
        const float t = v[i];
        v[i] = v[smallest];
        v[smallest] = t;
    }
    return v[4];
}

void main() {
    const ivec2 block = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(block, grid))) {
        return;
    }

    vec2 best;
    float best_cost;
    if (mode == 0) {
        best = vec2(0.0);
        best_cost = Cost(block, best, vec2(0.0), false);
        for (int dy = -SEARCH_RADIUS; dy <= SEARCH_RADIUS; ++dy) {
            for (int dx = -SEARCH_RADIUS; dx <= SEARCH_RADIUS; ++dx) {
                const vec2 v = vec2(dx, dy);
                const float cost = Cost(block, v, vec2(0.0), false);
                if (cost < best_cost) {
                    best_cost = cost;
                    best = v;
                }
            }
        }
        if (use_temporal != 0) {
            const vec2 v = TemporalField(block);
            const float cost = Cost(block, v, vec2(0.0), false);
            if (cost < best_cost) {
                best = v;
            }
        }
        imageStore(field_out, block, vec4(best, 0.0, 0.0));
        return;
    }

    float xs[9];
    float ys[9];
    int n = 0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            const vec2 v = InField(block + ivec2(dx, dy));
            xs[n] = v.x;
            ys[n] = v.y;
            ++n;
        }
    }
    const vec2 median = vec2(Median9(xs), Median9(ys));

    best = InField(block);
    best_cost = Cost(block, best, median, true);

    const ivec2 directions[4] = ivec2[4](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
    const int spreads[2] = int[2](1, 3);
    for (int s = 0; s < 2; ++s) {
        for (int d = 0; d < 4; ++d) {
            const vec2 v = InField(block + directions[d] * spreads[s]);
            const float cost = Cost(block, v, median, true);
            if (cost < best_cost) {
                best_cost = cost;
                best = v;
            }
        }
    }
    {
        const float cost = Cost(block, median, median, true);
        if (cost < best_cost) {
            best_cost = cost;
            best = median;
        }
    }
    if (use_temporal != 0) {
        vec2 v = TemporalField(block);
        float cost = Cost(block, v, median, true);
        if (cost < best_cost) {
            best_cost = cost;
            best = v;
        }
        for (int s = 0; s < 2; ++s) {
            for (int d = 0; d < 4; ++d) {
                v = TemporalField(block + directions[d] * spreads[s]);
                cost = Cost(block, v, median, true);
                if (cost < best_cost) {
                    best_cost = cost;
                    best = v;
                }
            }
        }
    }

    const vec2 centre = best;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            if (dx == 0 && dy == 0) {
                continue;
            }
            const vec2 v = centre + vec2(dx, dy);
            const float cost = Cost(block, v, median, true);
            if (cost < best_cost) {
                best_cost = cost;
                best = v;
            }
        }
    }
    imageStore(field_out, block, vec4(best, 0.0, 0.0));
}
