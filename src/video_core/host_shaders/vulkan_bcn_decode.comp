// Decodes raw BC1/2/3/4/5/7 blocks into the texels the CPU decoder (externals/bc_decoder) would
// produce, for GPUs that store BCn images decoded or recompressed: when a game copies raw blocks
// into such an image through another format, they have to be decoded on the GPU. One invocation
// decodes one 4x4 block.
//
// Output rows are padded to whole blocks (4 texels wide, 4 rows per block row) so every block
// writes whole words: RGBA8 for BC1/2/3/7, R8 for BC4, RG8 for BC5, signed formats as SNORM bytes.

#version 460 core

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer InputBlocks {
    uint blocks[];
};

layout(std430, set = 0, binding = 1) writeonly buffer OutputTexels {
    uint texels[];
};

layout(push_constant) uniform PushConstants {
    uint blocks_x;
    uint blocks_y;
    uint slices;
    uint format;
    uint is_signed;
    uint input_offset;  // in words
    uint output_offset; // in words
};

const uint FORMAT_BC1 = 1;
const uint FORMAT_BC2 = 2;
const uint FORMAT_BC3 = 3;
const uint FORMAT_BC4 = 4;
const uint FORMAT_BC5 = 5;
const uint FORMAT_BC7 = 7;

// BC7 partition and anchor tables (2 bits per texel; anchors: 2-subset | 3-subset second << 4 |
// 3-subset third << 8), from externals/bc_decoder.
const uint PARTITIONS_2[64] = uint[](
